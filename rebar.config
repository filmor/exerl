{minimum_otp_vsn, "27"}.

{project_plugins, [
    rebar3_hex,
    rebar3_ex_doc,
    erlfmt
]}.

{hex, [{doc, ex_doc}]}.

{ex_doc, [
    {extras, ["README.md", "LICENSE"]},
    {main, "README.md"},
    {source_url, "https://github.com/filmor/exerl"}
]}.

% Do not discover consumer fixture sources as EUnit test modules.
{eunit_test_regex, "_tests\\.erl$"}.

{profiles, [
    {test, [
        {plugins, [exerl]},
        {deps, [
            {rebar,
                {git_subdir, "https://github.com/erlang/rebar3", {tag, "3.27.3"}, "apps/rebar"}},
            {elixir_full, {ex, "1.16"}},
            {eqwalizer_support,
                {git_subdir, "https://github.com/whatsapp/eqwalizer.git", {branch, "main"},
                    "eqwalizer_support"}}
        ]}
    ]}
]}.

% Override the compile_opts for erlware_commons to not warn on bare catch.
{overrides, [
    {add, [
        {erl_opts, [nowarn_deprecated_catch, nowarn_match_alias_pats]}
    ]}
]}.
